# ── Variables Discord ──────────────────────────────────────────────────────────
DISCORD_TOKEN=

# ── Mode : 'production' ou 'development' ─────────────────────────────────────
NODE_ENV=development

# ── Serveur de PRODUCTION ─────────────────────────────────────────────────────
GUILD_ID=
CHANNEL_ID=

# ── Serveur de TEST ───────────────────────────────────────────────────────────
TEST_GUILD_ID=
TEST_CHANNEL_ID=

# ── Timezone ──────────────────────────────────────────────────────────────────
TIMEZONE=Europe/Paris

# ── URLs des calendriers iCal ─────────────────────────────────────────────────
ICS_URL_GROUPE1=
ICS_URL_GROUPE2=
ICS_URL_PM=

# ── IDs des rôles Discord ─────────────────────────────────────────────────────
ROLE_ID_DEV_WEB=
ROLE_ID_PGE=
ROLE_ID_DATA_AI=
ROLE_ID_MARKETING=
ROLE_ID_PM=